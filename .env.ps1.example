# Azure Configuration Variables - Example Template
# Copy this file to .env.ps1 and replace with your actual credentials
# DO NOT commit .env.ps1 to version control

# Microsoft 365 Tenant and Subscription Information
$env:TENANT_ID          = "your-tenant-id-here"
$env:APP_SUBSCRIPTION   = "your-app-subscription-id-here"
$env:INFRA_SUBSCRIPTION = "your-infra-subscription-id-here"

# Azure Subscription details
$env:RESOURCE_GROUP_NAME = "your-resource-group-name"
$env:AZURE_LOCATION = "eastus2"

# Azure Storage Account Configuration
$env:AZURE_STORAGE_ACCOUNT_NAME = "your-storage-account-name"
$env:AZURE_STORAGE_ACCOUNT_KEY = "your-storage-account-key"
$env:AZURE_STORAGE_CONNECTION_STRING = "DefaultEndpointsProtocol=https;AccountName=your-storage-account-name;AccountKey=your-storage-account-key;"

# Azure Search Service Configuration
$env:AZURE_SEARCH_SERVICE_NAME = "your-search-service-name"

# Container Names
$env:CONTAINER_NAME_REC = "recs"
$env:CONTAINER_NAME_PARSE = "parse"
